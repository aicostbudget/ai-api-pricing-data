{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicostbudget.com/schemas/ai-api-pricing/model.schema.json",
  "title": "AI API Pricing Model",
  "type": "object",
  "required": ["provider_id", "model_id", "display_name", "model_family", "status", "pricing", "official_source_url", "accessed_at", "last_verified_at", "effective_from", "notes"],
  "properties": {
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "model_id": {"type": "string"},
    "display_name": {"type": "string"},
    "model_family": {"type": "string"},
    "model_category": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "preview", "deprecated", "retired", "unknown"]},
    "release_stage": {"type": "string", "enum": ["stable", "preview", "legacy", "specialized", "unknown"]},
    "context_window_tokens": {"type": "integer", "minimum": 1},
    "input_modality": {"type": "string", "enum": ["text", "image", "audio", "video"]},
    "output_modality": {"type": "string", "enum": ["text", "image", "audio", "video"]},
    "pricing": {
      "type": "object",
      "required": ["currency", "unit", "input", "output", "cached_input", "cache_write", "cache_write_1h", "batch_input", "batch_output"],
      "properties": {
        "currency": {"type": "string", "const": "USD"},
        "unit": {"type": ["string", "null"], "enum": ["1M tokens", null]},
        "input": {"type": ["number", "null"], "minimum": 0},
        "output": {"type": ["number", "null"], "minimum": 0},
        "cached_input": {"type": ["number", "null"], "minimum": 0},
        "cache_write": {"type": ["number", "null"], "minimum": 0},
        "cache_write_1h": {"type": ["number", "null"], "minimum": 0},
        "batch_input": {"type": ["number", "null"], "minimum": 0},
        "batch_cached_input": {"type": ["number", "null"], "minimum": 0},
        "batch_output": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "pricing_tiers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/pricingTier"}
    },
    "pricing_periods": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/pricingPeriod"}
    },
    "time_pricing": {"$ref": "#/$defs/timePricing"},
    "pricing_components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pricingComponent"}
    },
    "price_records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/canonicalPriceRecord"}
    },
    "official_source_url": {"type": "string", "format": "uri"},
    "official_source_urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "accessed_at": {"type": "string", "format": "date-time"},
    "last_verified_at": {"type": "string", "format": "date-time"},
    "effective_from": {"type": ["string", "null"], "format": "date"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "canonicalPriceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "processing_mode", "context_class", "pricing_status", "calculation_default", "prompt_token_threshold", "effective_from", "effective_until", "currency", "charges", "region_policy", "source_refs", "verification_status", "checked_at", "verified_at", "billing_note"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "processing_mode": {"type": "string", "enum": ["standard", "batch", "flex", "priority", "fast"]},
        "context_class": {"type": "string", "enum": ["short", "long"]},
        "pricing_status": {"type": "string", "enum": ["current", "future", "historical"]},
        "calculation_default": {"type": "boolean"},
        "prompt_token_threshold": {"type": ["integer", "null"], "minimum": 0},
        "tier_selection": {"$ref": "#/$defs/canonicalTierSelection"},
        "effective_from": {"type": ["string", "null"], "format": "date"},
        "effective_until": {"type": ["string", "null"], "format": "date"},
        "currency": {"type": "string", "const": "USD"},
        "charges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/canonicalCharge"}},
        "region_policy": {"$ref": "#/$defs/canonicalRegionPolicy"},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "verification_status": {"type": "string", "enum": ["verified", "partially_verified", "unconfirmed_price", "stale", "review_required"]},
        "checked_at": {"type": "string", "format": "date-time"},
        "verified_at": {"type": "string", "format": "date-time"},
        "billing_note": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"required": ["tier_selection"]},
          "then": {"properties": {"prompt_token_threshold": {"type": "integer", "minimum": 0}}}
        }
      ]
    },
    "canonicalTierSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "token_basis", "cached_prompt_tokens_included", "whole_request_pricing"],
      "properties": {
        "comparison": {"type": "string", "enum": ["less_than", "less_than_or_equal", "greater_than", "greater_than_or_equal"]},
        "token_basis": {"type": "string", "const": "total_prompt_tokens"},
        "cached_prompt_tokens_included": {"type": "boolean", "const": true},
        "whole_request_pricing": {"type": "boolean", "const": true}
      }
    },
    "canonicalCharge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "modality", "unit", "amount"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "component": {"type": "string", "enum": ["input", "cached_input", "cache_write", "cache_write_5m", "cache_write_1h", "cache_read", "output", "storage", "request", "tool_call", "grounding", "document_page"]},
        "modality": {"type": "string", "enum": ["text", "image", "audio", "video", "document"]},
        "unit": {"type": "string", "enum": ["per_1m_tokens", "per_1k_calls", "per_1000_pages", "per_minute", "per_hour", "per_image", "per_second", "per_request"]},
        "amount": {
          "oneOf": [
            {"type": "number", "minimum": 0},
            {"type": "string", "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$"}
          ]
        }
      }
    },
    "canonicalRegionSelector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "endpoint_geographies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}},
        "data_residencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}}
      }
    },
    "canonicalAvailabilityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "status", "reason", "source_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "selector": {"$ref": "#/$defs/canonicalRegionSelector"},
        "status": {"type": "string", "enum": ["available", "unavailable"]},
        "reason": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}}
      }
    },
    "canonicalPriceAdjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "operation", "factor", "source_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "selector": {"$ref": "#/$defs/canonicalRegionSelector"},
        "operation": {"type": "string", "const": "multiply"},
        "factor": {
          "oneOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "string", "pattern": "^(?:0\\.(?:0*[1-9]\\d*)|[1-9]\\d*(?:\\.\\d+)?)$"}
          ]
        },
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}}
      }
    },
    "canonicalRegionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pricing_geography", "endpoint_geographies", "data_residencies", "availability", "price_adjustments"],
      "properties": {
        "pricing_geography": {"type": "string", "enum": ["global_base", "region_specific"]},
        "endpoint_geographies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}},
        "data_residencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}},
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "rules"],
          "properties": {
            "default": {"type": "string", "enum": ["available", "unavailable"]},
            "rules": {"type": "array", "items": {"$ref": "#/$defs/canonicalAvailabilityRule"}}
          }
        },
        "price_adjustments": {"type": "array", "items": {"$ref": "#/$defs/canonicalPriceAdjustment"}}
      }
    },
    "pricingComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "modality", "unit", "amount", "currency", "processing_mode", "pricing_status", "calculation_default", "effective_from", "effective_until"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "component": {"type": "string", "enum": ["document_page"]},
        "modality": {"type": "string", "enum": ["document"]},
        "unit": {"type": "string", "enum": ["per_1000_pages"]},
        "amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "const": "USD"},
        "processing_mode": {"type": "string", "enum": ["standard"]},
        "pricing_status": {"type": "string", "enum": ["current", "future", "historical"]},
        "calculation_default": {"type": "boolean"},
        "effective_from": {"type": ["string", "null"], "format": "date"},
        "effective_until": {"type": ["string", "null"], "format": "date"}
      }
    },
    "pricingPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pricing_status", "calculation_default", "effective_from", "effective_until", "pricing"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "pricing_status": {"type": "string", "enum": ["current", "future", "historical"]},
        "calculation_default": {"type": "boolean"},
        "effective_from": {"type": ["string", "null"], "format": "date"},
        "effective_until": {"type": ["string", "null"], "format": "date"},
        "pricing": {"$ref": "#/$defs/tokenPricing"}
      }
    },
    "tokenPricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "unit", "input", "output", "cached_input", "cache_write", "cache_write_1h", "batch_input", "batch_output"],
      "properties": {
        "currency": {"type": "string", "const": "USD"},
        "unit": {"type": ["string", "null"], "enum": ["1M tokens", null]},
        "input": {"type": ["number", "null"], "minimum": 0},
        "output": {"type": ["number", "null"], "minimum": 0},
        "cached_input": {"type": ["number", "null"], "minimum": 0},
        "cache_write": {"type": ["number", "null"], "minimum": 0},
        "cache_write_1h": {"type": ["number", "null"], "minimum": 0},
        "batch_input": {"type": ["number", "null"], "minimum": 0},
        "batch_cached_input": {"type": ["number", "null"], "minimum": 0},
        "batch_output": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "timePricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "rate_effective_from", "schedule_effective_from", "selection_basis", "recurrence", "default_period_id", "schedule_source_url", "schedule_accessed_at", "schedule_verified_at", "periods"],
      "properties": {
        "timezone": {"type": "string", "minLength": 1},
        "rate_effective_from": {"type": "string", "format": "date-time"},
        "schedule_effective_from": {"type": ["string", "null"], "format": "date-time"},
        "selection_basis": {"type": "string", "const": "request_time"},
        "recurrence": {"type": "string", "const": "weekly"},
        "default_period_id": {"type": "string", "minLength": 1},
        "schedule_source_url": {"type": "string", "format": "uri"},
        "schedule_accessed_at": {"type": "string", "format": "date-time"},
        "schedule_verified_at": {"type": "string", "format": "date-time"},
        "periods": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "contains": {"type": "object", "required": ["is_default"], "properties": {"is_default": {"const": true}}},
          "minContains": 1,
          "maxContains": 1,
          "items": {"$ref": "#/$defs/timePricingPeriod"}
        }
      }
    },
    "timePricingPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "is_default", "active_weekdays", "time_windows", "all_other_times", "pricing"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "is_default": {"type": "boolean"},
        "active_weekdays": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]}
        },
        "time_windows": {"type": "array", "items": {"$ref": "#/$defs/timeWindow"}},
        "all_other_times": {"type": "boolean"},
        "pricing": {"$ref": "#/$defs/timePeriodPricing"}
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "end": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
      }
    },
    "timePeriodPricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "unit", "input", "cached_input", "output"],
      "properties": {
        "currency": {"type": "string", "const": "USD"},
        "unit": {"type": "string", "const": "1M tokens"},
        "input": {"type": "number", "minimum": 0},
        "cached_input": {"type": "number", "minimum": 0},
        "output": {"type": "number", "minimum": 0}
      }
    },
    "pricingTier": {
      "type": "object",
      "required": [
        "id",
        "processing_mode",
        "pricing_status",
        "calculation_default",
        "prompt_token_threshold",
        "threshold_comparison",
        "threshold_token_basis",
        "cached_prompt_tokens_included",
        "whole_request_pricing",
        "currency",
        "unit",
        "input",
        "cached_input",
        "output"
      ],
      "properties": {
        "id": {"type": "string", "enum": ["short", "long"]},
        "processing_mode": {"type": "string", "enum": ["standard", "batch", "flex", "priority", "fast"]},
        "pricing_status": {"type": "string", "enum": ["current", "future", "historical"]},
        "calculation_default": {"type": "boolean"},
        "prompt_token_threshold": {"type": "integer", "minimum": 0},
        "threshold_comparison": {"type": "string", "enum": ["less_than", "less_than_or_equal", "greater_than", "greater_than_or_equal"]},
        "threshold_token_basis": {"type": "string", "enum": ["total_prompt_tokens"]},
        "cached_prompt_tokens_included": {"type": "boolean"},
        "whole_request_pricing": {"type": "boolean"},
        "currency": {"type": "string", "const": "USD"},
        "unit": {"type": "string", "const": "1M tokens"},
        "input": {"type": "number", "minimum": 0},
        "cached_input": {"type": "number", "minimum": 0},
        "output": {"type": "number", "minimum": 0}
      }
    }
  }
}
