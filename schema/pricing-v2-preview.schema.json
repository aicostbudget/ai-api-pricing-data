{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicostbudget.com/schemas/ai-api-pricing/pricing-v2-preview.schema.json",
  "title": "AICostBudget Pricing V2 Preview",
  "type": "object",
  "required": ["models", "prices", "sources", "modelIdentityRegistry", "candidateDispositionMap", "convergenceReport"],
  "properties": {
    "models": {
      "type": "array",
      "items": {"$ref": "#/$defs/modelRecord"}
    },
    "prices": {
      "type": "array",
      "items": {"$ref": "#/$defs/priceRecord"}
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceRecord"}
    },
    "modelIdentityRegistry": {
      "type": "array",
      "items": {"$ref": "#/$defs/identityRecord"}
    },
    "candidateDispositionMap": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidateDisposition"}
    },
    "convergenceReport": {
      "type": "object"
    }
  },
  "$defs": {
    "verificationStatus": {
      "type": "string",
      "enum": ["verified", "partially_verified", "unconfirmed_price", "stale", "review_required"]
    },
    "cacheEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumCacheablePrefixTokens", "verificationStatus", "checkedAt", "verifiedAt", "sourceRefs"],
      "properties": {
        "minimumCacheablePrefixTokens": {"type": "integer", "minimum": 0},
        "verificationStatus": {"$ref": "#/$defs/verificationStatus"},
        "checkedAt": {"type": "string", "format": "date-time"},
        "verifiedAt": {"type": "string", "format": "date-time"},
        "sourceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "conditionalUsageAllowance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowanceId", "offerType", "eligibility", "metric", "allowance", "billingPeriod", "usageScope", "duration", "regionSelector", "verificationStatus", "checkedAt", "verifiedAt", "sourceRefs", "note"],
      "properties": {
        "allowanceId": {"type": "string", "minLength": 1},
        "offerType": {"type": "string", "enum": ["short_term_trial"]},
        "eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["customerStatus", "accountPlan"],
          "properties": {
            "customerStatus": {"type": "string", "enum": ["new_customer", "existing_customer", "any_customer"]},
            "accountPlan": {"type": "string", "enum": ["free", "paid", "any"]}
          }
        },
        "metric": {"type": "string", "const": "document_page"},
        "allowance": {"type": "integer", "minimum": 1},
        "billingPeriod": {"type": "string", "enum": ["calendar_month"]},
        "usageScope": {"type": "string", "enum": ["unknown", "billing_account", "project", "processor", "region", "provider_account"]},
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit", "startsOn"],
          "properties": {
            "value": {"type": "integer", "minimum": 1},
            "unit": {"type": "string", "enum": ["month"]},
            "startsOn": {"type": "string", "enum": ["offer_activation"]}
          }
        },
        "regionSelector": {"$ref": "#/$defs/regionSelector"},
        "verificationStatus": {"$ref": "#/$defs/verificationStatus"},
        "checkedAt": {"type": "string", "format": "date-time"},
        "verifiedAt": {"type": "string", "format": "date-time"},
        "sourceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "cacheLifetimeMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationBehavior", "cacheWriteComponent", "isDefault", "minimumLifetimeSeconds", "renewalBehavior", "userSelectable", "verificationStatus", "checkedAt", "verifiedAt", "sourceRefs"],
      "properties": {
        "activationBehavior": {"type": "string", "enum": ["provider_automatic", "request_configured"]},
        "cacheWriteComponent": {"type": "string", "enum": ["cache_write", "cache_write_5m", "cache_write_1h"]},
        "isDefault": {"type": "boolean"},
        "minimumLifetimeSeconds": {"type": "integer", "minimum": 1},
        "renewalBehavior": {"type": "string", "enum": ["refresh_on_reuse"]},
        "userSelectable": {"type": "boolean"},
        "verificationStatus": {"$ref": "#/$defs/verificationStatus"},
        "checkedAt": {"type": "string", "format": "date-time"},
        "verifiedAt": {"type": "string", "format": "date-time"},
        "sourceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },    "officialId": {
      "type": "object",
      "required": ["id", "type", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["canonical", "alias", "snapshot", "pinned", "legacy", "historical_reference"]},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "identityRecord": {
      "type": "object",
      "required": [
        "providerId",
        "internalId",
        "displayName",
        "canonicalOfficialId",
        "officialIds",
        "websiteIds",
        "publicDatasetIds",
        "identityType",
        "lifecycleStatus",
        "releaseStage",
        "availability",
        "routingBehavior",
        "routingDetails",
        "aliasTargetInternalId",
        "redirectTargetInternalId",
        "billingModelInternalId",
        "replacementInternalId",
        "deprecationDate",
        "retirementDate",
        "verificationStatus",
        "sourceRefs"
      ],
      "properties": {
        "providerId": {"type": "string"},
        "internalId": {"type": "string"},
        "displayName": {"type": "string"},
        "contextWindowTokens": {"type": "integer", "minimum": 1},
        "canonicalOfficialId": {"type": "string"},
        "officialIds": {"type": "array", "items": {"$ref": "#/$defs/officialId"}},
        "websiteIds": {"type": "array", "items": {"type": "string"}},
        "publicDatasetIds": {"type": "array", "items": {"type": "string"}},
        "identityType": {"type": "string", "enum": ["canonical_model", "alias", "snapshot", "pinned_id", "historical_reference"]},
        "lifecycleStatus": {"type": "string", "enum": ["active", "deprecated", "retired", "unknown"]},
        "releaseStage": {"type": "string", "enum": ["stable", "preview", "legacy", "specialized", "unknown"]},
        "availability": {"type": "string"},
        "routingBehavior": {"type": "string"},
        "routingDetails": {"type": "object"},
        "aliasTargetInternalId": {"type": ["string", "null"]},
        "redirectTargetInternalId": {"type": ["string", "null"]},
        "billingModelInternalId": {"type": ["string", "null"]},
        "replacementInternalId": {"type": ["string", "null"]},
        "deprecationDate": {"type": ["string", "null"], "format": "date"},
        "retirementDate": {"type": ["string", "null"]},
        "scheduledTransition": {"$ref": "#/$defs/scheduledLifecycleTransition"},
        "verificationStatus": {"$ref": "#/$defs/verificationStatus"},
        "sourceRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "candidateDisposition": {
      "type": "object",
      "required": ["candidateId", "sourceSide", "provider", "finalInternalId", "disposition", "mergeTarget", "aliasTarget", "reason", "verificationStatus"],
      "properties": {
        "candidateId": {"type": "string"},
        "sourceSide": {"type": "string", "enum": ["public_only", "website_only", "common"]},
        "provider": {"type": "string"},
        "finalInternalId": {"type": "string"},
        "disposition": {"type": "string", "enum": ["canonical_identity", "alias", "pinned_id", "snapshot", "historical_reference", "merged_duplicate", "unresolved"]},
        "mergeTarget": {"type": ["string", "null"]},
        "aliasTarget": {"type": ["string", "null"]},
        "reason": {"type": "string"},
        "verificationStatus": {"$ref": "#/$defs/verificationStatus"}
      }
    },
    "modelRecord": {
      "type": "object",
      "required": [
        "providerId",
        "internalId",
        "displayName",
        "canonicalOfficialId",
        "officialIds",
        "lifecycleStatus",
        "releaseStage",
        "availability",
        "routingBehavior",
        "defaultPriceRecordId",
        "verificationStatus",
        "sourceRefs"
      ],
      "properties": {
        "providerId": {"type": "string"},
        "internalId": {"type": "string"},
        "displayName": {"type": "string"},
        "contextWindowTokens": {"type": "integer", "minimum": 1},
        "cacheEligibility": {"$ref": "#/$defs/cacheEligibility"},
        "cacheLifetimeModes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/cacheLifetimeMode"}},
        "conditionalUsageAllowances": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conditionalUsageAllowance"}},
        "canonicalOfficialId": {"type": "string"},
        "officialIds": {"type": "array", "items": {"$ref": "#/$defs/officialId"}},
        "lifecycleStatus": {"type": "string", "enum": ["active", "deprecated", "retired", "unknown"]},
        "releaseStage": {"type": "string", "enum": ["stable", "preview", "legacy", "specialized", "unknown"]},
        "availability": {"type": "string"},
        "routingBehavior": {"type": "string"},
        "defaultPriceRecordId": {"type": ["string", "null"]},
        "verificationStatus": {"$ref": "#/$defs/verificationStatus"},
        "sourceRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "priceRecord": {
      "type": "object",
      "required": [
        "pricingId",
        "modelInternalId",
        "processingMode",
        "contextClass",
        "regionPolicy",
        "promptTokenThreshold",
        "effectiveFrom",
        "effectiveUntil",
        "currency",
        "charges",
        "sourceRefs",
        "billingNote",
        "verificationStatus",
        "calculationDefault"
      ],
      "properties": {
        "pricingId": {"type": "string"},
        "modelInternalId": {"type": "string"},
        "processingMode": {"type": "string", "enum": ["standard", "batch", "flex", "priority", "fast"]},
        "pricingStatus": {"type": "string", "enum": ["current", "future", "historical"]},
        "contextClass": {"type": "string", "enum": ["short", "long"]},
        "regionPolicy": {"type": "string"},
        "regionSelector": {"$ref": "#/$defs/regionSelector"},
        "defaultAvailabilityStatus": {"type": "string", "enum": ["available", "unavailable"]},
        "availabilityRules": {"type": "array", "items": {"$ref": "#/$defs/availabilityRule"}},
        "priceAdjustments": {"type": "array", "items": {"$ref": "#/$defs/priceAdjustment"}},
        "promptTokenThreshold": {"type": ["integer", "null"], "minimum": 0},
        "tierSelection": {"$ref": "#/$defs/tierSelection"},
        "usageTier": {"$ref": "#/$defs/usageTier"},
        "temporalCondition": {"$ref": "#/$defs/temporalCondition"},
        "effectiveFrom": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "format": "date"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "effectiveUntil": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "format": "date"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "currency": {"type": "string", "const": "USD"},
        "charges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chargeRecord"}},
        "configuration": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "sourceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "billingNote": {"type": "string"},
        "verificationStatus": {"$ref": "#/$defs/verificationStatus"},
        "checkedAt": {"type": "string", "format": "date-time"},
        "verifiedAt": {"type": "string", "format": "date-time"},
        "calculationDefault": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"required": ["tierSelection"]},
          "then": {
            "properties": {
              "promptTokenThreshold": {"type": "integer", "minimum": 0}
            }
          }
        },
        {
          "if": {
            "required": ["contextClass", "pricingStatus"],
            "properties": {"contextClass": {"const": "long"}}
          },
          "then": {
            "properties": {
              "promptTokenThreshold": {"type": "integer", "minimum": 0}
            }
          }
        },
        {
          "if": {"required": ["regionSelector"]},
          "then": {"required": ["defaultAvailabilityStatus", "availabilityRules", "priceAdjustments", "checkedAt", "verifiedAt"]}
        }
      ]
    },
    "tierSelection": {
      "type": "object",
      "required": [
        "comparison",
        "tokenBasis",
        "cachedPromptTokensIncluded",
        "wholeRequestPricing"
      ],
      "properties": {
        "comparison": {
          "type": "string",
          "enum": ["less_than", "less_than_or_equal", "greater_than", "greater_than_or_equal"]
        },
        "tokenBasis": {"type": "string", "enum": ["total_prompt_tokens"]},
        "cachedPromptTokensIncluded": {"type": "boolean"},
        "wholeRequestPricing": {"type": "boolean"}
      }
    },
    "usageTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "tierStart", "tierEnd", "billingPeriod", "tierMode", "usageScope", "freeAllowance"],
      "properties": {
        "metric": {"type": "string", "const": "document_page"},
        "tierStart": {"type": "integer", "minimum": 0},
        "tierEnd": {"type": ["integer", "null"], "minimum": 1},
        "billingPeriod": {"type": "string", "enum": ["calendar_month"]},
        "tierMode": {"type": "string", "enum": ["graduated", "volume"]},
        "usageScope": {"type": "string", "enum": ["unknown", "billing_account", "project", "processor", "region", "provider_account"]},
        "freeAllowance": {"type": "integer", "minimum": 0}
      }
    },
    "scheduledLifecycleTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "effectiveFrom", "sourceSlugRemainsResolvable", "redirectTargetInternalId", "targetConfiguration", "billingSource", "billingModelInternalId", "billingConfiguration"],
      "properties": {
        "kind": {"type": "string", "const": "retirement_redirect"},
        "effectiveFrom": {"type": "string", "format": "date"},
        "sourceSlugRemainsResolvable": {"type": "boolean", "const": true},
        "redirectTargetInternalId": {"type": "string", "minLength": 1},
        "targetConfiguration": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "billingSource": {"type": "string", "const": "redirect_target"},
        "billingModelInternalId": {"type": "string", "minLength": 1},
        "billingConfiguration": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "regionSelector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "pricingGeography": {"type": "string", "enum": ["global_base", "region_specific"]},
        "endpointGeographies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}},
        "dataResidencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}}
      }
    },
    "regionRuleSelector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "endpointGeographies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}},
        "dataResidencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}}
      }
    },
    "availabilityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availabilityRuleId", "selector", "availabilityStatus", "reason", "sourceRefs"],
      "properties": {
        "availabilityRuleId": {"type": "string", "minLength": 1},
        "selector": {"$ref": "#/$defs/regionRuleSelector"},
        "availabilityStatus": {"type": "string", "enum": ["available", "unavailable"]},
        "reason": {"type": "string", "minLength": 1},
        "sourceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "priceAdjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priceAdjustmentId", "selector", "operation", "factor", "sourceRefs"],
      "properties": {
        "priceAdjustmentId": {"type": "string", "minLength": 1},
        "selector": {"$ref": "#/$defs/regionRuleSelector"},
        "operation": {"type": "string", "const": "multiply"},
        "factor": {"type": "string", "pattern": "^(?:0\\.(?:0*[1-9]\\d*)|[1-9]\\d*(?:\\.\\d+)?)$"},
        "sourceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "temporalCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodId", "timezone", "rateEffectiveFrom", "scheduleEffectiveFrom", "selectionBasis", "recurrence", "activeWeekdays", "timeWindows", "allOtherTimes", "defaultPeriodId", "scheduleSourceRefs"],
      "properties": {
        "periodId": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1},
        "rateEffectiveFrom": {"type": "string", "format": "date-time"},
        "scheduleEffectiveFrom": {"type": ["string", "null"], "format": "date-time"},
        "selectionBasis": {"type": "string", "const": "request_time"},
        "recurrence": {"type": "string", "const": "weekly"},
        "activeWeekdays": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]}},
        "timeWindows": {"type": "array", "items": {"$ref": "#/$defs/timeWindow"}},
        "allOtherTimes": {"type": "boolean"},
        "defaultPeriodId": {"type": "string", "minLength": 1},
        "scheduleSourceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "end": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
      }
    },
    "chargeRecord": {
      "type": "object",
      "required": ["chargeId", "component", "modality", "unit", "amount"],
      "properties": {
        "chargeId": {"type": "string"},
        "component": {
          "type": "string",
          "enum": ["input", "cached_input", "cache_write", "cache_write_5m", "cache_write_1h", "cache_read", "output", "storage", "request", "tool_call", "grounding", "document_page"]
        },
        "modality": {"type": "string", "enum": ["text", "image", "audio", "video", "document"]},
        "unit": {"type": "string", "enum": ["per_1m_tokens", "per_1k_calls", "per_1000_pages", "per_minute", "per_hour", "per_image", "per_second", "per_request"]},
        "amount": {"type": "string", "pattern": "^(0|[1-9]\\\\d*)(\\\\.\\\\d+)?$"}
      }
    },
    "sourceRecord": {
      "type": "object",
      "required": ["sourceId", "providerId", "url", "sourceType", "title", "checkedAt", "verifiedAt", "officialProviderDomain", "supports", "verificationStatus"],
      "properties": {
        "sourceId": {"type": "string"},
        "providerId": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "sourceType": {"type": "string"},
        "title": {"type": "string"},
        "accessedAt": {"type": ["string", "null"]},
        "checkedAt": {"type": ["string", "null"]},
        "verifiedAt": {"type": ["string", "null"]},
        "officialProviderDomain": {"type": "string"},
        "supports": {"type": "array", "items": {"type": "string"}},
        "verificationStatus": {"$ref": "#/$defs/verificationStatus"}
      }
    }
  }
}
