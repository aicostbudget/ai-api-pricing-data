{
  "name": "ai-api-pricing-data-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:mcpb": "npm run build:mcpb --workspace ai-api-pricing-mcp",
    "test:mcpb": "npm run test:mcpb --workspace ai-api-pricing-mcp"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
