{
  "name": "ai-api-pricing",
  "version": "0.1.1",
  "description": "Source-linked AI API pricing data and deterministic cost estimates.",
  "license": "MIT",
  "homepage": "https://github.com/aicostbudget/ai-api-pricing-data/tree/main/packages/ai-api-pricing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aicostbudget/ai-api-pricing-data.git",
    "directory": "packages/ai-api-pricing"
  },
  "bugs": {
    "url": "https://github.com/aicostbudget/ai-api-pricing-data/issues"
  },
  "keywords": [
    "llm",
    "llm-pricing",
    "ai-api-pricing",
    "token-cost",
    "cost-estimation",
    "openai",
    "anthropic",
    "gemini",
    "deepseek",
    "pricing-data"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "refresh-bundle": "node scripts/refresh-bundle.mjs",
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run refresh-bundle && npm run build"
  }
}
