{"announcement_url":"https://docs.x.ai/developers/release-notes","change_type":"model_added","currency":"USD","date_basis":"provider_announced","dedupe_key":"sha256:245e7a76a1f36bd8ad004b87a32bb592d0b0c50ce42f726dfeb54abb3c2327d8","detected_at":"2026-09-23","effective_from":"2026-09-21","event_id":"xai:grok-4.7:model_added:245e7a76a1f3","model_id":"grok-4.7","new_lifecycle":null,"new_prices":{"cached_input":0.5,"input":2,"output":6},"new_status":"active","notes":"Released on 2026-09-21 and available on the public xAI API. Supports text and image input with text output; reasoning efforts are low, medium, high (default), and xhigh. Global Standard rates use the short tier through 200,000 total prompt tokens and the long tier above 200,000; cached prompt tokens count toward the threshold and the selected tier prices the whole request. Grok 4.7 Fast is twice the Standard token rates but is available only in Cursor and Grok Build, not on the public xAI API, so it is excluded from public pricing rows. Batch API is not supported, no separate cache-write price is published, and the US regional endpoint applies a 1.10x premium to input, cached input, and output tokens, including long-context rates.","official_source_url":"https://docs.x.ai/developers/models/grok-4.7","old_lifecycle":null,"old_prices":{"cached_input":null,"input":null,"output":null},"old_status":null,"provider_id":"xai","schema_version":"1.0","source_snapshot_after":"data/snapshots/2026-09-23/prices.json","source_snapshot_before":"data/snapshots/2026-09-21/prices.json","unit":"1M tokens","verified_at":"2026-09-23"}
